<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 风格首页布局（借鉴 AVBox 视觉设计） -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <!-- 内容区：底部留白给导航栏 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/nav_wrapper" />

    <!-- 右上角菜单按钮（Material 3 icon button 风格） -->
    <ImageButton
        android:id="@+id/home_menu_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home_setting"
        android:src="@drawable/ic_menu_more"
        android:tint="@color/md_onSurface" />

    <!-- 底部导航容器：带顶部弧形的 MD3 悬浮栏 -->
    <FrameLayout
        android:id="@+id/nav_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/md3_nav_bar_bg"
            app:elevation="8dp"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/selector_nav"
            app:itemRippleColor="@color/md_primary"
            app:labelVisibilityMode="selected"
            app:menu="@menu/menu_nav" />

    </FrameLayout>

</RelativeLayout>
